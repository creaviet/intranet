# Copy to .env and replace every placeholder before deployment.
DATABASE_URI=mongodb://mongo:27017/intranet
PAYLOAD_SECRET=replace-with-at-least-32-random-bytes
NEXTAUTH_SECRET=replace-with-a-separate-random-secret
NEXTAUTH_URL=http://localhost:3000
# Local-only login without an IdP (email form on the sign-in page).
# Ignored whenever NODE_ENV=production. Keep false for shared environments.
ALLOW_DEV_LOGIN=false

# Existing employee identity provider (OIDC). Register this callback at the IdP:
# http://localhost:3000/api/auth/callback/company
OIDC_ISSUER=https://identity.example.com/realms/company
OIDC_CLIENT_ID=intranet
OIDC_CLIENT_SECRET=replace-me
OIDC_SCOPE=openid profile email

# The app requires a verified email claim. Restrict allowed domains in src/auth/config.ts.
ALLOWED_EMAIL_DOMAINS=example.com
